  "worlds": [
    {
      "id": "xu",
      "name": "序 · 海图",
      "en": "The Chart",
      "whisper": "一艘没有桨的船",
      "chart": false,
      "mood": "prologue",
      "start": "wake",
      "scenes": {
        "wake": {
          "text": [
            "你在一艘小船上醒来。",
            "船没有桨，也没有帆。海是灰的，天也是灰的。你不记得自己是谁，只记得两个字：回家。",
            "雾里有钟声，一声，又一声。像是有人在很远的地方，敲给谁听。"
          ],
          "choices": [
            { "label": "循着钟声", "to": "bell" },
            { "label": "先摸一摸船板", "to": "board" }
          ]
        },
        "board": {
          "text": [
            "船板上刻过字。被人用刀划掉了，划痕很深。",
            "你用手指顺着刻痕摸过去，摸出一个名字的形状——可你念不出来。",
            "雾里又响了一声钟。这次近了些。"
          ],
          "fragment": {
            "id": "frag-scratch",
            "text": "船板上刻过一个名字。被人亲手划掉了。",
            "glyph": "痕",
            "star": [18, 82]
          },
          "choices": [
            { "label": "循着钟声", "to": "bell" }
          ]
        },
        "bell": {
          "text": [
            "钟浮在水面上，是一口倒扣的铜钟，里面没有钟舌。",
            "你把手贴上去。钟自己响了，雾被震开一道缝。",
            "缝里露出一张摊开的海图。图角有一行铅笔字：‘别急，灯会等你。’"
          ],
          "note": {
            "id": "obs-chart",
            "text": "海图角落有一行铅笔字：别急，灯会等你。"
          },
          "choices": [
            { "label": "展开海图", "to": "chart" }
          ]
        },
        "chart": {
          "text": [
            "图上画着七座岛，和一座灯塔。灯塔的位置是空的，只有一点光。",
            "船没有桨。可你只要想着‘去那里’，船就慢慢动了。",
            "回家之前，你大概得先去别处看看。"
          ],
          "choices": [
            { "label": "合上海图", "to": "#chart" }
          ]
        }
      }
    },
    {
      "id": "jingmo",
      "name": "静默屿",
      "en": "The Silent Isle",
      "whisper": "一座没有声音的岛",
      "chart": true,
      "chartPos": [20, 20],
      "mood": "silent",
      "rule": "在这座岛上，说出口的话会化作雾，飘向你真正想去的地方。",
      "start": "s-arrive",
      "scenes": {
        "s-arrive": {
          "text": [
            "静默屿从雾里靠过来，像一件被慢慢推近的家具。",
            "岛上没有鸟，没有风，也没有浪声。灯塔立在礁石上，灯亮着，却不转。",
            "守灯人站在灯下，看着你，不说话。"
          ],
          "choices": [
            { "label": "喊他", "to": "s-call" },
            { "label": "安静地走近", "to": "s-quiet" },
            { "label": "问他：我该怎么回家", "to": "s-ask" }
          ]
        },
        "s-call": {
          "text": [
            "你喊了一声。声音离开你的嘴，变成一团白雾，飘向灯塔。",
            "守灯人摇摇头，把食指竖在唇边。",
            "你又喊了一声，更大声。雾更浓了，可方向一点也没变。"
          ],
          "note": {
            "id": "obs-louder",
            "text": "喊得越大声，雾越浓；但雾的方向始终是同一个。"
          },
          "choices": [
            { "label": "停下来", "to": "s-quiet" },
            { "label": "问他：我该怎么回家", "to": "s-ask" }
          ]
        },
        "s-ask": {
          "text": [
            "「我该怎么回家？」",
            "话一出口就散了。雾在你面前打转，久久没有方向。",
            "守灯人看着那团雾，又看看你。他张了张嘴，没有声音。",
            "你忽然明白：你连‘家’在哪里都说不清，雾能往哪儿去呢。"
          ],
          "note": {
            "id": "obs-ask",
            "text": "话里没有确切的地方，雾就没有方向。"
          },
          "choices": [
            { "label": "安静下来", "to": "s-quiet" }
          ]
        },
        "s-quiet": {
          "text": [
            "你不再说话。",
            "雾慢慢停下来，像一条被拉直的线，飘向灯塔，飘向灯下的礁石。",
            "守灯人点了点头。他走到礁石边，从石缝里取出一块发亮的东西。"
          ],
          "choices": [
            { "label": "跟着雾走过去", "to": "s-gift" },
            { "label": "先看清他的脸", "to": "s-face" }
          ]
        },
        "s-face": {
          "text": [
            "你想看清守灯人的脸。灯太亮了，他的脸在光里，像被水洗过。",
            "你只看见他的手——手背上有一道旧疤，像是握了很多年的灯。",
            "他把碎片递过来时，手没有抖。"
          ],
          "note": {
            "id": "obs-keeper",
            "text": "守灯人的手背上有一道旧疤。"
          },
          "choices": [
            { "label": "接过碎片", "to": "s-gift" }
          ]
        },
        "s-gift": {
          "text": [
            "是一块碎片，温热，像刚从谁的胸口取出来。",
            "你接住它，听见一个很远的声音：有人在灯下等你。",
            "灯塔的光扫过海面，照出一条发亮的路。路很短，只够走到下一座岛。"
          ],
          "fragment": {
            "id": "frag-lamp",
            "text": "有人在灯下等我。我记得那盏灯。",
            "glyph": "灯",
            "star": [50, 28]
          },
          "learnRule": true,
          "choices": [
            { "label": "踏上光路", "to": "s-end" }
          ]
        },
        "s-end": {
          "text": [
            "你回头看。守灯人还站在灯下，没有挥手。",
            "静默屿慢慢退回雾里。",
            "你试着在心里说了一声谢谢。这一次，没有雾出现——原来有些话，不用说出口也算数。"
          ],
          "choices": [
            { "label": "回到海图", "to": "#chart" }
          ]
        }
      }
    },
    {
      "id": "wufeng",
      "name": "无风之海",
      "en": "The Windless Sea",
      "whisper": "一片平得像玻璃的海",
      "chart": true,
      "chartPos": [50, 10],
      "mood": "windless",
      "rule": "这片海上没有风，只有旧日的航迹。",
      "start": "w-arrive",
      "scenes": {
        "w-arrive": {
          "text": [
            "海面平得像一块玻璃。帆垂着，一动不动。",
            "水上有许多航迹，旧的叠着新的，像谁在这里写过很多遍同一个字。",
            "没有风。可你的船在动。"
          ],
          "choices": [
            { "label": "循着带雨味的航迹", "to": "w-rain" },
            { "label": "循着有歌声的航迹", "to": "w-song" },
            { "label": "循着那道没有起点的航迹", "to": "w-own" }
          ]
        },
        "w-rain": {
          "text": [
            "航迹带你穿过一团低低的雨云。雨落在脸上，很凉。",
            "你想起一扇门，门口放着一把伞，伞下没有人。",
            "航迹到这里就断了。断得很干净，像有人把话说到一半。"
          ],
          "note": {
            "id": "obs-rain",
            "text": "有一条航迹带着雨味，尽头是一把没人撑的伞。"
          },
          "choices": [
            { "label": "回到静水中央", "to": "w-arrive" }
          ]
        },
        "w-song": {
          "text": [
            "航迹尽头有人在唱歌。你靠近，歌声却退开了。",
            "你听见一句词，像在哄孩子睡觉。",
            "歌没有唱完，海就把它收了回去。"
          ],
          "note": {
            "id": "obs-song",
            "text": "歌里的最后一句，是‘别怕’。"
          },
          "choices": [
            { "label": "回到静水中央", "to": "w-arrive" }
          ]
        },
        "w-own": {
          "text": [
            "你低头看自己的船尾。那里拖着一道航迹，笔直，没有起点——因为它从你这里开始。",
            "这片海上所有的路都是别人走过的。只有这一条，是你自己的。",
            "你顺着它走。帆没有动，船在动。"
          ],
          "choices": [
            { "label": "继续向前", "to": "w-deep" }
          ]
        },
        "w-deep": {
          "text": [
            "航迹尽头，水面下有一样东西在发亮。",
            "你伸手去捞，捞起一块湿漉漉的记忆。它在你手心里滴着水，像刚被谁放下。"
          ],
          "fragment": {
            "id": "frag-rain",
            "text": "下雨天，门口会放一把伞。伞总是干的。",
            "glyph": "雨",
            "star": [38, 46]
          },
          "learnRule": true,
          "choices": [
            { "label": "离开这片静水", "to": "w-end" }
          ]
        },
        "w-end": {
          "text": [
            "你回头看那些旧的航迹。它们并没有消失，只是不再需要你了。",
            "海还是静的。你忽然觉得，静不是空，是有人替你安静了很久。"
          ],
          "choices": [
            { "label": "回到海图", "to": "#chart" }
          ]
        }
      }
    },
    {
      "id": "huisheng",
      "name": "回声阶",
      "en": "The Echo Stair",
      "whisper": "一段向上、看不见尽头的石阶",
      "chart": true,
      "chartPos": [80, 20],
      "mood": "echo",
      "rule": "每一级台阶都会把你的脚步还给你；只有重复的，才算走过。",
      "start": "e-arrive",
      "scenes": {
        "e-arrive": {
          "text": [
            "雾里出现一段石阶，向上，看不到头。",
            "你踏上第一级。脚步声响起，却没有停——它又响了一遍，像有人跟在你身后。",
            "你回头。身后的石阶是空的。"
          ],
          "echo": true,
          "choices": [
            { "label": "继续向上", "to": "e-climb" },
            { "label": "停下来听", "to": "e-listen" }
          ]
        },
        "e-listen": {
          "text": [
            "你停下来。回声也停下来。",
            "你等了一会儿，它又轻轻响了一下，像是催促。",
            "石阶旁的苔藓里，开着一小片白花。花瓣在动，可这里没有风。"
          ],
          "note": {
            "id": "obs-echo",
            "text": "脚步会响两遍；只响一遍的，不算走过。"
          },
          "echo": true,
          "choices": [
            { "label": "继续向上", "to": "e-climb" }
          ]
        },
        "e-climb": {
          "text": [
            "你继续向上。每走一步，脚步就被还回来一次。",
            "走到半山腰，你听见上面有人在喊一个名字。",
            "那是你的名字吗？你不敢确定。回声把它拉得很长。"
          ],
          "echo": true,
          "choices": [
            { "label": "应一声", "to": "e-answer" },
            { "label": "不出声，继续走", "to": "e-keep" }
          ]
        },
        "e-answer": {
          "text": [
            "你应了一声。声音在石阶上弹跳，越弹越远。",
            "上面的人没有回应。回声回来了，空空的，只剩一个尾音。",
            "你才明白：在这里，喊出去的话不会到达任何人；它只会回到你这里。"
          ],
          "note": {
            "id": "obs-answer",
            "text": "回声只回得来，去不了。"
          },
          "echo": true,
          "choices": [
            { "label": "继续向上", "to": "e-top" }
          ]
        },
        "e-keep": {
          "text": [
            "你没有出声。",
            "脚步一声一声，被石阶还回来。你数着：一步，两步，三步……",
            "数到第一百步时，你发现自己已经不记得在数什么了。"
          ],
          "choices": [
            { "label": "继续向上", "to": "e-top" }
          ]
        },
        "e-top": {
          "text": [
            "石阶尽头是一口小钟，挂在两根石柱之间。钟下坐着一个孩子。",
            "他抬头看你，眼睛很亮。‘你终于走到了。’他说，‘我敲了很久。’",
            "他敲了一下钟。钟声没有响——它先响在你的胸口。"
          ],
          "choices": [
            { "label": "接过钟槌", "to": "e-strike" },
            { "label": "问他叫什么", "to": "e-ask" }
          ]
        },
        "e-ask": {
          "text": [
            "「你叫什么？」",
            "他想了想：‘我在这里等一个人。等到他想起来，我就有名字了。’",
            "他把钟槌递给你。钟槌很轻，像一截骨头。"
          ],
          "note": {
            "id": "obs-child",
            "text": "钟下的孩子在等一个人想起他。"
          },
          "choices": [
            { "label": "接过钟槌", "to": "e-strike" }
          ]
        },
        "e-strike": {
          "text": [
            "你接过钟槌，敲了一下。",
            "钟声从你胸口穿过去，带出一个名字。",
            "你想抓住它，它已经散了。可你记住了它的形状——两个字，念起来像有人在门口等你。",
            "孩子笑了。他的脸开始变得透明。"
          ],
          "fragment": {
            "id": "frag-name",
            "text": "有人喊过一个名字。回声里，那个名字像我的。",
            "glyph": "名",
            "star": [50, 54]
          },
          "learnRule": true,
          "choices": [
            { "label": "走下石阶", "to": "e-end" }
          ]
        },
        "e-end": {
          "text": [
            "你走下石阶。这一次，脚步只响了一遍。",
            "孩子没有跟来。你回头时，石阶已经消失在雾里，只有那口钟还在响，很远，很轻。"
          ],
          "choices": [
            { "label": "回到海图", "to": "#chart" }
          ]
        }
      }
    },
    {
      "id": "wuming",
      "name": "无名渡",
      "en": "The Nameless Ferry",
      "whisper": "一块字被磨平的渡口木牌",
      "chart": true,
      "chartPos": [88, 48],
      "mood": "nameless",
      "rule": "在这里，名字没有用；只有你做过的事会被记住。",
      "start": "n-arrive",
      "scenes": {
        "n-arrive": {
          "text": [
            "渡口。一块木牌立在岸边，字被磨平了。",
            "摆渡人坐在船头，斗笠遮着脸。他问：‘你是谁？’",
            "你张开嘴，发现自己的名字像一块被舔过的糖，什么都不剩。"
          ],
          "choices": [
            {
              "label": "「我为一个人留过灯。」",
              "to": "n-lamp",
              "requires": { "hasFragments": ["frag-lamp"] }
            },
            {
              "label": "「我在雨里等过一个人。」",
              "to": "n-rain",
              "requires": { "hasFragments": ["frag-rain"] }
            },
            {
              "label": "「有人喊过我的名字。」",
              "to": "n-name",
              "requires": { "hasFragments": ["frag-name"] }
            },
            { "label": "「我什么都不记得了。」", "to": "n-empty" }
          ]
        },
        "n-lamp": {
          "text": [
            "摆渡人抬起头。‘留灯的人，一般都在等人。’",
            "他把船撑离岸。水很浅，篙却没有触到底。",
            "‘你要去哪里？’他问。",
            "你说不出地名，只说：‘回去。’他点点头，好像这就够了。"
          ],
          "note": {
            "id": "obs-deed",
            "text": "在渡口，做过的事比名字有用。"
          },
          "choices": [
            { "label": "上船", "to": "n-cross" }
          ]
        },
        "n-rain": {
          "text": [
            "‘等过多久？’他问。",
            "‘不知道。雨停了，人也没来。’",
            "他笑了一声，很短。‘那你上船吧。等过的人，坐得稳。’"
          ],
          "note": {
            "id": "obs-rain-wait",
            "text": "等过的人，坐得稳。"
          },
          "choices": [
            { "label": "上船", "to": "n-cross" }
          ]
        },
        "n-name": {
          "text": [
            "‘谁喊的？’",
            "‘不知道。回声里，像是我自己。’",
            "摆渡人沉默了一会儿。‘自己喊自己，也算是有人喊。’",
            "他把篙一撑，船离了岸。"
          ],
          "note": {
            "id": "obs-callself",
            "text": "自己喊自己，也算是有人喊。"
          },
          "choices": [
            { "label": "上船", "to": "n-cross" }
          ]
        },
        "n-empty": {
          "text": [
            "‘什么都不记得，’他重复了一遍，‘那你凭什么上船？’",
            "你答不上来。",
            "他从怀里摸出一张旧船票，递给你。票上印着一个日期，是你醒来的那天。",
            "‘有人替你买过了。’"
          ],
          "note": {
            "id": "obs-ticket",
            "text": "有人替你买过一张船票。日期是你醒来的那天。"
          },
          "choices": [
            { "label": "上船", "to": "n-cross" }
          ]
        },
        "n-cross": {
          "text": [
            "船到江心，雾浓得看不见两岸。",
            "摆渡人忽然说：‘名字是别人给你的，做过的事是你自己的。到了对岸，别弄丢。’",
            "他把船靠岸，没有收钱。岸上放着一块碎片，像谁忘了带走。"
          ],
          "fragment": {
            "id": "frag-deed",
            "text": "有人记得我做过的事。",
            "glyph": "事",
            "star": [42, 64]
          },
          "learnRule": true,
          "choices": [
            { "label": "上岸", "to": "n-end" }
          ]
        },
        "n-end": {
          "text": [
            "你上岸，回头看。渡口已经不见了，只有那块被磨平的木牌浮在水上。",
            "你忽然想：也许名字不是丢了，是被我留在了什么地方，等我自己去拿。"
          ],
          "choices": [
            { "label": "回到海图", "to": "#chart" }
          ]
        }
      }
    },
    {
      "id": "chengxing",
      "name": "秤星岛",
      "en": "The Scale Star",
      "whisper": "一座铜做的秤，和一颗吊着的星",
      "chart": true,
      "chartPos": [70, 76],
      "mood": "scale",
      "rule": "这座岛给一切称重；你带走的，都要留下等重的东西。",
      "start": "c-arrive",
      "scenes": {
        "c-arrive": {
          "text": [
            "这座岛是一架秤。",
            "岛中央立着一根铜柱，柱上横着一条臂；一端是秤盘，一端是一颗星。",
            "一个商人坐在秤下，面前摆着许多小抽屉。‘你带了什么？’他问，‘我什么都收。’"
          ],
          "choices": [
            { "label": "问他收不收记忆", "to": "c-ask" },
            { "label": "看那些抽屉", "to": "c-drawers" }
          ]
        },
        "c-drawers": {
          "text": [
            "抽屉上贴着标签：名字、方向、痛、一个下午、雨声、母亲的歌。",
            "有一个抽屉是空的，标签写着‘还没发生’。",
            "你拉开它。里面是一张白纸。纸上什么也没有，可你看了很久。"
          ],
          "note": {
            "id": "obs-drawer",
            "text": "有一个抽屉，标签是‘还没发生’。"
          },
          "choices": [
            { "label": "回去问商人", "to": "c-ask" }
          ]
        },
        "c-ask": {
          "text": [
            "「记忆怎么称？」",
            "商人把一个砝码放在秤盘上，星星沉下去一点。‘不称重量，称舍得。’",
            "他指了指岛另一头的路。‘想过去可以，留下等重的东西。’"
          ],
          "choices": [
            { "label": "走到秤前", "to": "c-scale" }
          ]
        },
        "c-scale": {
          "text": [
            "秤盘空着，等你放东西。",
            "你摸了摸胸口，那些碎片还在发暖。",
            "商人看着你，不催。星星在他头顶轻轻晃。"
          ],
          "choices": [
            { "label": "放上一块记忆", "to": "c-paid", "cost": 1 },
            {
              "label": "放上那个被划掉的名字",
              "to": "c-name",
              "takeFragment": "frag-scratch",
              "requires": { "hasFragments": ["frag-scratch"] }
            },
            { "label": "什么也不放，转身离开", "to": "c-refuse" }
          ]
        },
        "c-paid": {
          "text": [
            "你从胸口取出一块碎片，放在秤盘上。",
            "它一离开你，你就忘了它是什么。只记得自己曾拥有过。",
            "秤稳稳地停住。商人点点头：‘够了。’",
            "他指了指路。你走过去，脚下很轻，轻得有点慌。"
          ],
          "enter": { "flags": ["paid_memory"], "clearFlags": ["owe_sea"] },
          "choices": [
            { "label": "走过秤", "to": "c-road" }
          ]
        },
        "c-name": {
          "text": [
            "你把那块船板碎片放在秤盘上。",
            "秤几乎没动。商人挑了挑眉：‘一个被划掉的名字，这么轻？’",
            "‘因为我自己也不记得了。’",
            "他收下了它。‘不记得的东西，最轻。走吧。’"
          ],
          "enter": { "flags": ["nameless_paid"], "clearFlags": ["owe_sea"] },
          "choices": [
            { "label": "走过秤", "to": "c-road" }
          ]
        },
        "c-refuse": {
          "text": [
            "你把手收回来。",
            "‘我欠的，我自己还。’",
            "商人看了你很久，忽然笑了。‘那你欠着吧。’",
            "他抬手，秤臂缓缓倾斜，路在你面前露出来。‘记着，海会替我要。’"
          ],
          "enter": { "flags": ["owe_sea"] },
          "note": {
            "id": "obs-owe",
            "text": "商人说：欠着的东西，海会替你要。"
          },
          "choices": [
            { "label": "走过秤", "to": "c-road" }
          ]
        },
        "c-road": {
          "text": [
            "路从岛的这一头通到那一头，很短。",
            "走到一半，你听见身后有东西落地的声音——是秤盘空了，轻轻磕在铜柱上。",
            "你没有回头。"
          ],
          "choices": [
            { "label": "走向那棵树", "to": "c-gift" }
          ]
        },
        "c-gift": {
          "text": [
            "岛的另一头，长着一棵很小的树。树上结着一颗果子，果皮透明，里面装着一点光。",
            "你摘下来，它在手心里化了，变成一句话：",
            "‘你得先放下，才拿得动更重的东西。’"
          ],
          "fragment": {
            "id": "frag-promise",
            "text": "我答应过一个人：我一定会回去。",
            "glyph": "诺",
            "star": [58, 64]
          },
          "learnRule": true,
          "choices": [
            { "label": "离开秤星岛", "to": "c-end" }
          ]
        },
        "c-end": {
          "text": [
            "你离开时，身后的秤还在轻轻晃。",
            "星星们一句话也没说。你摸了摸胸口，那里空了一块，也满了一块。"
          ],
          "choices": [
            { "label": "回到海图", "to": "#chart" }
          ]
        }
      }
    },
    {
      "id": "zhiyue",
      "name": "纸月",
      "en": "The Paper Moon",
      "whisper": "一轮近得不真实的月亮",
      "chart": true,
      "chartPos": [30, 76],
      "mood": "paper",
      "rule": "月亮是纸折的；你折一下天，路就换个方向。",
      "start": "m-arrive",
      "scenes": {
        "m-arrive": {
          "text": [
            "夜。",
            "一轮很大的月亮挂在海面上，近得不真实。",
            "你伸手去够，指尖碰到纸的触感——月亮是纸折的，边上有清晰的折痕。"
          ],
          "choices": [
            { "label": "沿着折痕看", "to": "m-crease" },
            { "label": "什么也不做", "to": "m-wait" }
          ]
        },
        "m-crease": {
          "text": [
            "折痕从月亮一直落到海上，像一条白色的路。",
            "路的尽头站着一个孩子——不，是一张剪纸的人形，被夜色贴着。",
            "你走近。剪纸轻轻颤了一下，没有跑。"
          ],
          "note": {
            "id": "obs-crease",
            "text": "纸月的折痕会落到海上，变成路。"
          },
          "choices": [
            { "label": "和它说话", "to": "m-paper" }
          ]
        },
        "m-wait": {
          "text": [
            "你站着不动。月亮也不动。",
            "过了很久，你听见纸张被翻动的声音。有人在很远的地方，翻着一页很薄的夜。",
            "你忽然觉得，这轮月亮是有人特意为你折亮的。"
          ],
          "note": {
            "id": "obs-maker",
            "text": "有人折了一轮纸月，挂在这里。"
          },
          "choices": [
            { "label": "沿着折痕看", "to": "m-crease" }
          ]
        },
        "m-paper": {
          "text": [
            "剪纸人开口了，声音像纸摩擦：‘你来得太早了。我还没折好。’",
            "它指了指月亮的一角，那里有一道没压平的折痕。",
            "‘帮我按一下。’"
          ],
          "choices": [
            { "label": "按住那道折痕", "to": "m-press" },
            { "label": "问它在折什么", "to": "m-ask" }
          ]
        },
        "m-ask": {
          "text": [
            "「折什么？」",
            "‘折一条路。有人怕黑，总得有点亮。’",
            "它顿了一下。‘本来想折一个家。可家里的样子，我记不清了。’"
          ],
          "note": {
            "id": "obs-home",
            "text": "剪纸人想折一个家，却记不清家的样子。"
          },
          "choices": [
            { "label": "按住那道折痕", "to": "m-press" }
          ]
        },
        "m-press": {
          "text": [
            "你把手按在月亮的一角。纸很薄，薄得能看见对面的星星。",
            "折痕在你指下轻轻翘起，像一道没有合拢的门。",
            "你听见夜被折了一下。"
          ],
          "fold": {
            "label": "按下折痕，把月亮折起来",
            "text": [
              "月亮沿着你的手指折了过去。世界晃了一下。",
              "海竖了起来。一条路出现在你脚下。",
              "原来路一直藏在折痕里。"
            ],
            "choices": [
              { "label": "踏上折痕", "to": "m-folded" }
            ]
          }
        },
        "m-folded": {
          "text": [
            "你站在折起来的夜色上，脚下是月亮的内侧。",
            "那里贴满了小小的纸人：有的在等，有的在走，有的已经褪色。",
            "最中间的那个纸人，和你长得一模一样。"
          ],
          "choices": [
            { "label": "揭下那个纸人", "to": "m-self" },
            { "label": "转身离开", "to": "m-leave" }
          ]
        },
        "m-self": {
          "text": [
            "你揭下纸人。它很轻，背面写着一行小字：‘别怕，我把灯留在这里了。’",
            "你认得这个字迹——和船板上被划掉的名字，是同一个人写的。"
          ],
          "note": {
            "id": "obs-hand",
            "text": "纸人背面的字，和船板上的刻痕是同一个人写的。"
          },
          "choices": [
            { "label": "收好纸人", "to": "m-end" }
          ]
        },
        "m-leave": {
          "text": [
            "你转过身。纸做的海在脚下轻轻响。",
            "剪纸人在身后说：‘路会一直在这里。你什么时候回来，都亮着。’",
            "你没有回头。可你知道，月亮会一直折着。"
          ],
          "choices": [
            { "label": "离开纸月", "to": "m-end" }
          ]
        },
        "m-end": {
          "text": [
            "你离开纸月。回头看时，那轮月亮还挂在那儿，像一封没有拆开的信。",
            "海面很黑。可你走的那条路，一直亮到看不见为止。"
          ],
          "fragment": {
            "id": "frag-moon",
            "text": "有人怕黑，为我折了一轮月亮。",
            "glyph": "月",
            "star": [62, 46]
          },
          "learnRule": true,
          "choices": [
            { "label": "回到海图", "to": "#chart" }
          ]
        }
      }
    },
    {
      "id": "guichao",
      "name": "归潮",
      "en": "The Returning Tide",
      "whisper": "退潮后，海滩上铺满旧物",
      "chart": true,
      "chartPos": [12, 48],
      "mood": "tide",
      "rule": "你扔进海里的，都会在退潮时回来。",
      "start": "t-arrive",
      "scenes": {
        "t-arrive": {
          "text": [
            "退潮。",
            "海滩上铺满了海还回来的东西：一只木梳、一把钥匙、一艘纸船、一枚纽扣。",
            "它们都很旧，却都干干净净，像被谁一件件擦过。"
          ],
          "choices": [
            { "label": "走近看", "to": "t-shore" },
            { "label": "听潮水", "to": "t-listen" }
          ]
        },
        "t-listen": {
          "text": [
            "你把耳朵贴近水面。潮水在低声念着什么，一遍一遍。",
            "你听不清，只觉得那声音很耐心，像在数：一件，两件，三件……",
            "它在数它还给你的东西。"
          ],
          "note": {
            "id": "obs-count",
            "text": "潮水在数它还回来的东西。"
          },
          "choices": [
            { "label": "走近那些东西", "to": "t-shore" }
          ]
        },
        "t-shore": {
          "text": [
            "你在那些旧物之间走。",
            "忽然，你看见一块熟悉的碎片——是你留在秤星岛的那一块，或者是在别处丢下的什么。",
            "它被海水磨圆了一点，可还是你的。"
          ],
          "choices": [
            { "label": "把它们捡起来", "to": "t-return" }
          ]
        },
        "t-return": {
          "text": [
            "你把它们一块一块捡起来。有些你记得，有些你不记得。",
            "海不解释，只是把它们推到你脚边。",
            "你数了数。海把该还的都还了；至于不该还的，它记着账。"
          ],
          "returnLost": true,
          "choices": [
            { "label": "走向海滩尽头", "to": "t-door" }
          ]
        },
        "t-door": {
          "text": [
            "海滩尽头，立着一扇门。",
            "没有墙，没有房子，门框上挂着一盏小灯。门缝里漏出一点暖光，像有人在里面。",
            "门没有锁。可你伸手去推，手指却穿了过去。",
            "潮水退去，门上浮出一行字：‘灯在等你。’"
          ],
          "choices": [
            { "label": "转身看向海面", "to": "t-end" }
          ]
        },
        "t-end": {
          "text": [
            "你捡起最后一块碎片。",
            "海面平静下来。远处有一点光，比任何一座岛都亮。",
            "你知道那是灯塔。你一直知道。"
          ],
          "fragment": {
            "id": "frag-door",
            "text": "门没有锁。家里一直亮着灯。",
            "glyph": "门",
            "star": [82, 82]
          },
          "learnRule": true,
          "choices": [
            { "label": "回到海图", "to": "#chart" }
          ]
        }
      }
    },
